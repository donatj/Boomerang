{
	"name": "boomerang/boomerang",
	"type": "library",
	"homepage": "https://boomerang.work/",
	"description": "The Boomerang API Endpoint Testing Framework.",
	"keywords": [
		"api",
		"testing"
	],
	"license": "MIT",
	"support": {
		"issues": "https://github.com/donatj/Boomerang/issues"
	},
	"require": {
		"donatj/cli-toolkit": "~0.3",
		"donatj/flags": "~1",
		"composer-runtime-api": "^2.0",
		"php": ">=7.4",
		"ext-curl": "*",
		"ext-SPL": "*",
		"ext-json": "*"
	},
	"require-dev": {
		"donatj/drop": "*",
		"donatj/mock-webserver": "~2.10",
		"phpunit/phpunit": "^9",
		"ralouphie/getallheaders": "^3.0",
		"phpstan/phpstan": "2.2.7",
		"friendsofphp/php-cs-fixer": "^3.1",
		"squizlabs/php_codesniffer": "^4.0",
		"corpus/coding-standard": "^0.10"
	},
	"authors": [
		{
			"name": "Jesse G. Donat",
			"email": "donatj@gmail.com",
			"homepage": "https://donatstudios.com",
			"role": "Lead"
		}
	],
	"autoload": {
		"psr-0": {
			"Boomerang": "src/"
		}
	},
	"bin": [
		"composer/bin/boomerang"
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
